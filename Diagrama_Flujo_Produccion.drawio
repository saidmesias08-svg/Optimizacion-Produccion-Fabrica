  <diagram id="flujo-produccion" name="Diagrama de flujo">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="INICIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="30" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="init" value="Inicializar arreglos:&lt;br&gt;nombres, cantidades,&lt;br&gt;tiempos y recursos&lt;br&gt;total = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="menu" value="Mostrar menú:&lt;br&gt;1 Registrar&lt;br&gt;2 Mostrar&lt;br&gt;3 Editar&lt;br&gt;4 Eliminar&lt;br&gt;5 Calcular producción&lt;br&gt;6 Salir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="570" y="240" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="choice" value="¿Qué opción&lt;br&gt;seleccionó?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="450" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="reg" value="1. Registrar producto&lt;br&gt;Verificar límite de 5&lt;br&gt;Ingresar datos y validar&lt;br&gt;Incrementar total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="650" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="show" value="2. Mostrar productos&lt;br&gt;Si total = 0, avisar&lt;br&gt;Si no, recorrer arreglos&lt;br&gt;y mostrar cada producto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="650" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="edit" value="3. Editar producto&lt;br&gt;Solicitar nombre&lt;br&gt;Buscar con ciclo y strcmp&lt;br&gt;Si existe, modificar datos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="630" y="650" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="delete" value="4. Eliminar producto&lt;br&gt;Solicitar nombre y buscar&lt;br&gt;Desplazar datos posteriores&lt;br&gt;Disminuir total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="930" y="650" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="calc" value="5. Calcular producción&lt;br&gt;Ingresar tiempo y recursos disponibles&lt;br&gt;Calcular totales y comparar&lt;br&gt;Mostrar si cumple la demanda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="650" width="300" height="120" as="geometry"/>
        </mxCell>
